# Contact form email (ZeptoMail). Used by the serverless function api/contact.js,
# never exposed to the browser. Set these in Vercel under Settings ->
# Environment Variables. See docs/contact-form-setup.md.

# Required. Send Mail token from ZeptoMail -> Mail Agents -> (agent) -> SMTP/API -> API.
ZEPTOMAIL_TOKEN=

# Optional. Only for non-US ZeptoMail accounts, e.g. https://api.zeptomail.eu/v1.1/email
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Optional. Sender for both emails; must be on a domain verified in ZeptoMail.
# CONTACT_FROM=noreply@sagestoneinc.com

# Optional. Where enquiry notifications go.
# CONTACT_TO=hello@sagestoneinc.com
