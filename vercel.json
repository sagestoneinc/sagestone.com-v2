{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/services/virtual-assistant", "destination": "/services/virtual-assistant-services", "statusCode": 301 },
    { "source": "/services/customer-support", "destination": "/services/customer-support-outsourcing", "statusCode": 301 },
    { "source": "/services/back-office", "destination": "/services/back-office-support", "statusCode": 301 },
    { "source": "/services/executive-assistance", "destination": "/services/executive-assistant-services", "statusCode": 301 },
    { "source": "/services/remote-operations", "destination": "/services/remote-operations-support", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/:path*/index.html" }
  ]
}
